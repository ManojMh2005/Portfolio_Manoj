// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
//
// Logic:
//  - Anyone visiting the site can WRITE a new contact message (submit the form)
//    and WRITE to the resume download counter (click "Resume").
//  - Nobody can read messages or the counter unless they are signed in —
//    that's what makes /#admin private. Only the admin account you create in
//    Firebase Authentication can sign in, so only you can read this data.
//  - Nobody (not even signed-in users) can edit or delete existing messages,
//    so the contact form can't be used to tamper with past submissions.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.name.size() < 200
                    && request.resource.data.message.size() < 5000;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    match /stats/{statId} {
      allow read: if request.auth != null;
      allow write: if true; // only ever incremented from the client, never read publicly
    }
  }
}
